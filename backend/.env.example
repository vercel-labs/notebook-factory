APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
# Use a Supabase/Vercel Marketplace Postgres URL on Vercel. Local default is SQLite.
DATABASE_URL=
# Sandbox uses Vercel OIDC on deployments. Locally: vercel env pull, or set these:
# VERCEL_OIDC_TOKEN=
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Optional public Blob store for published HTML; absent locally uses database HTML.
BLOB_READ_WRITE_TOKEN=
# AI chat uses Vercel AI Gateway via deployment OIDC (or this optional local key).
# AI_GATEWAY_API_KEY=
# AI_MODEL=gateway:openai/gpt-6-luna
# Live sidebar uses Vercel Queues on deployments (OIDC); locally changes broadcast in-process.
# QUEUE_REGION=iad1
# Test the queue path locally: python -m vercel.queue.devserver, then set VERCEL_QUEUE_BASE_URL.
# VERCEL_QUEUE_BASE_URL=
